{
  "name": "sam-image-app-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3030",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "npm run build",
    "build:tauri": "npm run tauri -- build --ci",
    "build:app": "npm run tauri -- build --ci --no-bundle",
    "build:debug": "npm run tauri -- build --ci --debug",
    "build:win": "npm run tauri -- build --ci --bundles nsis,msi",
    "build:windows": "npm run build:win",
    "build:exe": "npm run tauri -- build --ci --bundles nsis",
    "build:nsis": "npm run build:exe",
    "build:msi": "npm run tauri -- build --ci --bundles msi",
    "bundle:win": "npm run tauri -- bundle --ci --bundles nsis,msi",
    "bundle:windows": "npm run bundle:win",
    "bundle:exe": "npm run tauri -- bundle --ci --bundles nsis",
    "bundle:nsis": "npm run bundle:exe",
    "bundle:msi": "npm run tauri -- bundle --ci --bundles msi",
    "preview": "vite preview --host 127.0.0.1 --port 3031",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:rust": "node scripts/cargo-cli.cjs test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run test:rust && npm run build",
    "check:release": "npm run check && npm run test:e2e && npm run build:app",
    "tauri:dev": "npm run tauri -- dev",
    "tauri:info": "npm run tauri -- info",
    "tauri": "node scripts/tauri-cli.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.10"
  }
}
