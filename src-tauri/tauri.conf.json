{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SamImage",
  "version": "0.1.0",
  "identifier": "com.samimage.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SamImage",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "useLocalToolsDir": true,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
